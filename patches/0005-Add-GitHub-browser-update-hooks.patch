index d17559d66..381091076 100644
--- a/chromium_src/chrome/browser/first_run/upgrade_util_win.cc
+++ b/chromium_src/chrome/browser/first_run/upgrade_util_win.cc
@@ -248,4 +248,37 @@ bool InvokeGoogleUpdateForRenameBrave() {
 
 }  // namespace
 
+#include "brave/browser/github_updater/github_updater.h"
+#include "chrome/browser/first_run/upgrade_util.h"
+
+#define RelaunchChromeBrowserImpl RelaunchChromeBrowserImpl_ChromiumImpl
 #include <chrome/browser/first_run/upgrade_util_win.cc>  // IWYU pragma: export
+#undef RelaunchChromeBrowserImpl
+
+namespace upgrade_util {
+
+bool RelaunchChromeBrowserImpl(const base::CommandLine& command_line,
+                               bool force_breakaway_from_job,
+                               bool wait_for_parent) {
+  auto helper = github_updater::GetHelper();
+  if (helper.empty()) {
+    return RelaunchChromeBrowserImpl_ChromiumImpl(
+        command_line, force_breakaway_from_job, wait_for_parent);
+  }
+  base::CommandLine command(helper);
+  command.AppendSwitch("relaunch");
+  command.AppendSwitchASCII("parent-pid",
+                            base::NumberToString(base::GetCurrentProcId()));
+  command.AppendArgNative(L"--");
+  const auto& args = command_line.argv();
+  for (size_t i = 1; i < args.size(); ++i) {
+    command.AppendArgNative(args[i]);
+  }
+  base::LaunchOptions options;
+  options.start_hidden = true;
+  options.force_breakaway_from_job_ = force_breakaway_from_job;
+  options.grant_foreground_privilege = true;
+  return base::LaunchProcess(command, options).IsValid();
+}
+
+}  // namespace upgrade_util
