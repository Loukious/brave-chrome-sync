+// SPDX-License-Identifier: MPL-2.0
+#ifndef BRAVE_BROWSER_GITHUB_UPDATER_GITHUB_UPDATER_H_
+#define BRAVE_BROWSER_GITHUB_UPDATER_GITHUB_UPDATER_H_
+
+#include "base/base_paths.h"
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/path_service.h"
+#include "base/process/launch.h"
+#include "base/task/thread_pool.h"
+
+namespace github_updater {
+
+inline base::FilePath GetHelper() {
+  base::FilePath directory;
+  if (!base::PathService::Get(base::DIR_EXE, &directory) ||
+      !base::PathExists(directory.AppendASCII("sync-install-root.txt"))) {
+    return {};
+  }
+  auto helper = directory.AppendASCII("SyncUpdater.exe");
+  return base::PathExists(helper) ? helper : base::FilePath();
+}
+
+inline void StartBackgroundCheck() {
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce([] {
+        auto helper = GetHelper();
+        if (helper.empty()) {
+          return;
+        }
+        base::CommandLine command(helper);
+        command.AppendSwitch("background");
+        base::LaunchOptions options;
+        options.start_hidden = true;
+        base::LaunchProcess(command, options);
+      }));
+}
+
+}  // namespace github_updater
+#endif  // BRAVE_BROWSER_GITHUB_UPDATER_GITHUB_UPDATER_H_
