@@ -0,0 +1,147 @@
+// SPDX-License-Identifier: MPL-2.0
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_WIN)
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/memory/weak_ptr.h"
+#include "base/process/launch.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/thread_pool.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "base/values.h"
+#include "brave/browser/github_updater/github_updater.h"
+#include "chrome/browser/ui/webui/help/version_updater.h"
+
+namespace {
+
+base::FilePath LaunchCheck() {
+  auto helper = github_updater::GetHelper();
+  base::FilePath status;
+  if (helper.empty() || !base::CreateTemporaryFile(&status)) {
+    return {};
+  }
+  base::CommandLine command(helper);
+  command.AppendSwitch("check");
+  command.AppendSwitchPath("status-file", status);
+  base::LaunchOptions options;
+  options.start_hidden = true;
+  if (!base::LaunchProcess(command, options).IsValid()) {
+    base::DeleteFile(status);
+    return {};
+  }
+  return status;
+}
+
+std::optional<base::DictValue> ReadStatus(base::FilePath path) {
+  std::string contents;
+  if (!base::ReadFileToStringWithMaxSize(path, &contents, 16384)) {
+    return std::nullopt;
+  }
+  auto value = base::JSONReader::ReadDict(contents, base::JSON_PARSE_RFC);
+  if (value && value->FindBool("done").value_or(false)) {
+    base::DeleteFile(path);
+  }
+  return value;
+}
+
+class GitHubVersionUpdater : public VersionUpdater {
+ public:
+  void CheckForUpdate(StatusCallback callback, PromoteCallback) override {
+    weak_factory_.InvalidateWeakPtrs();
+    timer_.Stop();
+    callback_ = std::move(callback);
+    callback_.Run(CHECKING, 0, false, false, {}, 0, {});
+    deadline_ = base::TimeTicks::Now() + base::Minutes(45);
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&LaunchCheck),
+        base::BindOnce(&GitHubVersionUpdater::OnStarted,
+                       weak_factory_.GetWeakPtr()));
+  }
+
+ private:
+  void OnStarted(base::FilePath path) {
+    if (path.empty()) {
+      callback_.Run(FAILED, 0, false, false, {}, 0,
+                    u"Install Brave Chrome Sync using its GitHub setup installer to enable updates.");
+      return;
+    }
+    status_path_ = std::move(path);
+    reading_ = false;
+    timer_.Start(FROM_HERE, base::Milliseconds(500), this,
+                 &GitHubVersionUpdater::Poll);
+    Poll();
+  }
+
+  void Poll() {
+    if (reading_) {
+      return;
+    }
+    if (base::TimeTicks::Now() > deadline_) {
+      timer_.Stop();
+      callback_.Run(FAILED, 0, false, false, {}, 0,
+                    u"The update check timed out. Try again.");
+      return;
+    }
+    reading_ = true;
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&ReadStatus, status_path_),
+        base::BindOnce(&GitHubVersionUpdater::OnStatus,
+                       weak_factory_.GetWeakPtr()));
+  }
+
+  void OnStatus(std::optional<base::DictValue> value) {
+    reading_ = false;
+    if (!value) {
+      return;
+    }
+    const auto* name = value->FindString("status");
+    if (!name) {
+      return;
+    }
+    Status status = CHECKING;
+    if (*name == "updating") {
+      status = UPDATING;
+    } else if (*name == "ready") {
+      status = NEARLY_UPDATED;
+    } else if (*name == "updated") {
+      status = UPDATED;
+    } else if (*name == "failed") {
+      status = FAILED;
+    }
+    const auto* version = value->FindString("version");
+    const auto* message = value->FindString("message");
+    callback_.Run(status,
+                  status == UPDATING ? value->FindInt("progress").value_or(0) : 0,
+                  false, false, version ? *version : std::string(), 0,
+                  message ? base::UTF8ToUTF16(*message) : std::u16string());
+    if (value->FindBool("done").value_or(false)) {
+      timer_.Stop();
+    }
+  }
+
+  StatusCallback callback_;
+  base::FilePath status_path_;
+  base::TimeTicks deadline_;
+  base::RepeatingTimer timer_;
+  bool reading_ = false;
+  base::WeakPtrFactory<GitHubVersionUpdater> weak_factory_{this};
+};
+
+}  // namespace
+
+std::unique_ptr<VersionUpdater> VersionUpdater::Create(content::WebContents*) {
+  return std::make_unique<GitHubVersionUpdater>();
+}
