+#define BRAVE_PROBE_CURRENT_DEFAULT_HANDLERS                            \
+  if (auto sync = brave_chrome_sync::Find(chrome_exe.value())) {         \
+    for (const auto& identifier : identifiers) {                        \
+      if (!brave_chrome_sync::ResolvesToLauncher(                       \
+              *sync, identifier.c_str(), type == AT_URLPROTOCOL)) {     \
+        return ShellUtil::NOT_DEFAULT;                                 \
+      }                                                               \
+    }                                                                 \
+    return ShellUtil::IS_DEFAULT;                                      \
+  }
+#define BRAVE_REGISTER_CHROME_BROWSER_IMPL                              \
+  if (auto sync = brave_chrome_sync::Find(chrome_exe.value())) {         \
+    return brave_chrome_sync::HasProtocol(*sync, L"http") &&             \
+           brave_chrome_sync::HasProtocol(*sync, L"https");              \
+  }
+#define BRAVE_SHOW_MAKE_CHROME_DEFAULT_SYSTEM_UI                         \
+  if (auto sync = brave_chrome_sync::Find(chrome_exe.value())) {         \
+    return GetChromeDefaultState() == IS_DEFAULT ||                     \
+           base::win::LaunchSettingsDefaultApps(sync->name, true);      \
+  }
+#define BRAVE_REGISTER_CHROME_FOR_PROTOCOLS                              \
+  if (auto sync = brave_chrome_sync::Find(chrome_exe.value())) {         \
+    for (const auto& association : protocol_associations.associations) { \
+      if (!brave_chrome_sync::HasProtocol(*sync, association.first)) {   \
+        return false;                                                 \
+      }                                                               \
+    }                                                                 \
+    return true;                                                      \
+  }
 #include <chrome/installer/util/shell_util.cc>
