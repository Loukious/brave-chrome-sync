diff --git a/chromium_src/chrome/installer/util/sync_browser_registration.h b/chromium_src/chrome/installer/util/sync_browser_registration.h
new file mode 100644
index 000000000..724a7367f
--- /dev/null
+++ b/chromium_src/chrome/installer/util/sync_browser_registration.h
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: MPL-2.0
+#ifndef BRAVE_CHROMIUM_SRC_CHROME_INSTALLER_UTIL_SYNC_BROWSER_REGISTRATION_H_
+#define BRAVE_CHROMIUM_SRC_CHROME_INSTALLER_UTIL_SYNC_BROWSER_REGISTRATION_H_
+
+#include <windows.h>
+#include <shlwapi.h>
+
+#include <initializer_list>
+#include <iterator>
+#include <optional>
+#include <string>
+
+namespace brave_chrome_sync {
+
+struct Registration {
+  std::wstring root;
+  std::wstring name;
+  std::wstring capabilities;
+};
+
+inline bool EqualPath(const std::wstring& left, const std::wstring& right) {
+  return CompareStringOrdinal(left.c_str(), -1, right.c_str(), -1, TRUE) ==
+         CSTR_EQUAL;
+}
+
+inline std::wstring RegistryString(const std::wstring& key,
+                                   const std::wstring& value) {
+  wchar_t buffer[32768];
+  DWORD bytes = sizeof(buffer);
+  if (RegGetValueW(HKEY_CURRENT_USER, key.c_str(), value.c_str(), RRF_RT_REG_SZ,
+                   nullptr, buffer, &bytes) != ERROR_SUCCESS) {
+    return {};
+  }
+  return buffer;
+}
+
+inline bool IsFile(const std::wstring& path) {
+  const DWORD attributes = GetFileAttributesW(path.c_str());
+  return attributes != INVALID_FILE_ATTRIBUTES &&
+         !(attributes & FILE_ATTRIBUTE_DIRECTORY);
+}
+
+inline std::optional<Registration> Find(const std::wstring& executable) {
+  const auto separator = executable.find_last_of(L"\\/");
+  if (separator == std::wstring::npos) {
+    return std::nullopt;
+  }
+  const auto directory = executable.substr(0, separator);
+  const auto version_separator = directory.find_last_of(L"\\/");
+  if (version_separator == std::wstring::npos) {
+    return std::nullopt;
+  }
+  const auto versions = directory.substr(0, version_separator);
+  const auto root_separator = versions.find_last_of(L"\\/");
+  if (root_separator == std::wstring::npos ||
+      !EqualPath(versions.substr(root_separator + 1), L"versions") ||
+      !IsFile(directory + L"\\sync-release.json")) {
+    return std::nullopt;
+  }
+  const auto root = versions.substr(0, root_separator);
+  if (!IsFile(root + L"\\SyncBrowser.exe")) {
+    return std::nullopt;
+  }
+  for (const auto* channel : {L"release", L"beta", L"nightly"}) {
+    const auto client = std::wstring(
+        L"Software\\Clients\\StartMenuInternet\\BraveChromeSync-") + channel;
+    if (!EqualPath(RegistryString(client, L"InstallRoot"), root)) {
+      continue;
+    }
+    const auto name = std::wstring(L"Brave Chrome Sync") +
+                      (std::wstring(channel) == L"release" ? L"" :
+                       std::wstring(channel) == L"beta" ? L" Beta" : L" Nightly");
+    const auto capabilities = client + L"\\Capabilities";
+    if (RegistryString(L"Software\\RegisteredApplications", name) ==
+        capabilities) {
+      return Registration{root, name, capabilities};
+    }
+  }
+  return std::nullopt;
+}
+
+inline bool ResolvesToLauncher(const Registration& registration,
+                               const wchar_t* identifier,
+                               bool protocol) {
+  wchar_t executable[32768];
+  DWORD length = static_cast<DWORD>(std::size(executable));
+  const auto flags = protocol ? ASSOCF_IS_PROTOCOL : ASSOCF_NONE;
+  return SUCCEEDED(AssocQueryStringW(flags, ASSOCSTR_EXECUTABLE, identifier,
+                                    L"open", executable, &length)) &&
+         EqualPath(executable, registration.root + L"\\SyncBrowser.exe");
+}
+
+inline bool HasProtocol(const Registration& registration,
+                         const std::wstring& protocol) {
+  const auto prog_id = RegistryString(
+      registration.capabilities + L"\\URLAssociations", protocol);
+  return !prog_id.empty() &&
+         ResolvesToLauncher(registration, prog_id.c_str(), false);
+}
+
+}  // namespace brave_chrome_sync
+
+#endif  // BRAVE_CHROMIUM_SRC_CHROME_INSTALLER_UTIL_SYNC_BROWSER_REGISTRATION_H_
diff --git a/patches/chrome-installer-util-shell_util.cc.patch b/patches/chrome-installer-util-shell_util.cc.patch
